{
  "name": "obsidiankit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:seo": "tsx scripts/generate-seo-assets.ts",
    "generate:prerender-routes": "tsx scripts/generate-prerender-routes.ts",
    "build": "npm run generate:prerender-routes && npm run generate:seo && tsc -b && vite build && tsx scripts/generate-static-seo-pages.ts && npm run check:bundle",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "lint": "eslint .",
    "test": "tsx scripts/test-integrity.ts",
    "preview": "vite preview"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "@pdfsmaller/pdf-encrypt-lite": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "2.0.2",
    "docx": "^9.7.1",
    "heic2any": "0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "mammoth": "^1.12.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "tsx": "^4.23.12",
    "vite": "^8.2.2"
  }
}
